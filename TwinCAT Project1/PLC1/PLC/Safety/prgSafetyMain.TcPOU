    <Action Name="actSafetyEnableOutputs" Id="{395105ee-916d-0f07-2c1f-42c938aa8b8d}">
      <Implementation>
        <ST><![CDATA[//enable output signals
IF Mc_Global.PowerOn THEN
	stdOutputs.iOutput1 := TRUE; //pnuematic air on
	stdOutputs.iOutput2 := TRUE;
	stdOutputs.iOutput3 := TRUE;
	stdOutputs.iOutput4 := TRUE;	
ELSE
	stdOutputs.iOutput1 := FALSE;
	stdOutputs.iOutput2 := FALSE;
	stdOutputs.iOutput3 := FALSE;
	stdOutputs.iOutput4 := FALSE;	
END_IF]]></ST>
      </Implementation>
    </Action>
