<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="FB_ReadTextList" Id="{753ba71e-9963-4f30-a92a-880b0f36d270}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ReadTextList
VAR_INPUT
    iTargetfilestring : STRING(255) := 'C:\PLC\Messages\FileName.XML';
    iStart            : BOOL;
    iReset            : BOOL;
END_VAR
VAR_OUTPUT
   // theemessage       : STRING(255);
    qOutIndex          : INT;


END_VAR
VAR
	fHandle           : UINT;
	bBusy             : BOOL;
    bError            : BOOL;
    nErrId            : UDINT;
	
    // State Machine
    nState            : INT := 0; 
    
    // TwinCAT File FBs
    fbFileOpen        : FB_FileOpen;
    fbFileGets        : FB_FileGets;
    fbFileClose       : FB_FileClose;
    
    // Triggers
    rtStart           : R_TRIG;
    rtReset           : R_TRIG;
    
    // Internal Variables
    hFile             : UINT := 0;
    sLineData         : STRING(255);
    
    // Logic Parsers
    findText          : FB_FindTextIndexNum;
    findLangText      : FB_FindTextLangText;
    
    // Counters & Statuses
    nLineCounter      : INT := 0;
    bIsCorrectLine    : BOOL;
END_VAR

 VAR_IN_OUT
      iqTextList : ARRAY[0..GlobalMessages.gNumMessagesPerType] OF STRING(255); 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Edge Detection & Global Reset Control
rtStart(CLK := iStart);
rtReset(CLK := iReset);

IF rtReset.Q AND (nState <> 0) THEN
    nState := 90; // Jump immediately to the safe cleanup/close sequence
END_IF

// 2. The Asynchronous Control State Machine
CASE nState OF
    0: (* IDLE STATE *)
        bBusy := FALSE;
        IF rtStart.Q THEN
            bBusy          := TRUE;
            bError         := FALSE;
            nErrId         := 0;
            nLineCounter   := 0;
         //   theemessage    := '';
            qOutIndex       := 0;
            nState         := 10;
        END_IF

    10: (* OPEN THE FILE *)
        fbFileOpen(
            sNetId   := '',
            sPathName:= iTargetfilestring,
            nMode    := FOPEN_MODEREAD,
            ePath    := PATH_GENERIC,
            bExecute := TRUE,
            tTimeout := T#1S
        );

        IF NOT fbFileOpen.bBusy THEN
            IF fbFileOpen.bError THEN
                bError := TRUE;
                nErrId := fbFileOpen.nErrId;
                nState := 99; // Jump to error state
            ELSE
                hFile  := fbFileOpen.hFile;
                fHandle:= hFile; // Diagnostic output
                nState := 20;
            END_IF
            fbFileOpen(bExecute := FALSE); // Reset FB execution toggle
        END_IF

    20: (* INITIATE LINE READ *)
        fbFileGets(
            sNetId   := '',
            hFile    := hFile,
            bExecute := TRUE,
            tTimeout := T#1S
        );
        nState := 30;

  30: (* WAIT FOR LINE READ COMPLETED *)
    fbFileGets(); // Call the block to let it update
    
    IF NOT fbFileGets.bBusy THEN
        IF fbFileGets.bError THEN
            bError := TRUE;
            nErrId := fbFileGets.nErrId;
            nState := 90; 
        ELSIF fbFileGets.bEOF THEN
            nState := 90; 
        ELSE
            sLineData := fbFileGets.sLine; // Correctly extract the string data here
            nState    := 40; 
        END_IF
        fbFileGets(bExecute := FALSE); 
    END_IF

   40: (* PROCESS AND PARSE XML DATA *)
        // Check for textlist index number
        findText(iText := sLineData);
        
        IF findText.qLineIsValid THEN
            nLineCounter := 0; // Reset language distance counter
        ELSE
            nLineCounter := nLineCounter + 1; 
        END_IF

        // Determine if this line matches the language location offset
        bIsCorrectLine := (nLineCounter = LanguageLocation.DefaultLanguage);

        IF bIsCorrectLine THEN
            findLangText(iText := sLineData);
            
            // Ensure the extracted index is within your array bounds to prevent PLC crash
            IF findText.qIndexNum >= 0 AND findText.qIndexNum <= GlobalMessages.gNumMessagesPerType THEN
                
                // Capture standard language text
                IF findLangText.qIsValidString THEN
                    iqTextList[findText.qIndexNum] := findLangText.qTextidline3;
                    
                // Capture extended language translation text
                ELSIF findLangText.qIsValidExtendedString THEN
                    iqTextList[findText.qIndexNum] := findLangText.qExtendedTextline;
                END_IF
                
            END_IF
        END_IF

        // CRITICAL CHANGE: Instead of going to 90, always loop back to read the next line
        // The file will now only close when State 30 detects 'fbFileGets.bEOF'
        nState := 20; 

    90: (* SAFE FILE CLOSE INITIATION *)
        fbFileClose(
            sNetId   := '',
            hFile    := hFile,
            bExecute := TRUE,
            tTimeout := T#1S
        );
        nState := 95;

    95: (* WAIT FOR FILE TO CLOSE *)
        fbFileClose();
        IF NOT fbFileClose.bBusy THEN
            hFile        := 0;
            fHandle      := 0;
            fbFileClose(bExecute := FALSE);
            nState       := 0; // Return to idle ready for next run
        END_IF

    99: (* FAULT HANDLING STATE *)
        bBusy   := FALSE;
        fHandle := 0;
        hFile   := 0;
        IF rtStart.Q OR rtReset.Q THEN
            nState := 0; // Clear error on new try or reset command
        END_IF
END_CASE]]></ST>
    </Implementation>
    <LineIds Name="FB_ReadTextList">
      <LineId Id="564" Count="130" />
      <LineId Id="80" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>