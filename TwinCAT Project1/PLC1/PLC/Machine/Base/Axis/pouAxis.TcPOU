    <Action Name="actClearScreen" Id="{a9ff748a-de6a-4eb1-8d41-a39e8e6638f7}">
      <Implementation>
        <ST><![CDATA[//clear HMI row for manual insertion
axis.gAxisRows.gMotionRow1.IndexLocation := 0;
axis.gAxisRows.gMotionRow2.IndexLocation := 20;
axis.gAxisRows.gMotionRow3.IndexLocation := 40;
axis.gAxisRows.gMotionRow4.IndexLocation := 60;
axis.gAxisRows.gMotionRow5.IndexLocation := 80;
axis.gAxisRows.gMotionRow6.IndexLocation := 100;

//clear axis row layout
axis.gAxisNumRows := 0;

//debug
axis.isAxisStandStill := TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="actReadNCData" Id="{4a2db1ec-cf80-0edb-2e21-5bdd11b7a724}">
      <Implementation>
        <ST><![CDATA[osrRead	(	CLK	:= System.StartPulse	);

IF osrRead.Q AND NOT bDone THEN
	//need to check all ethercat slaves present ok, really, before doing a load of ADS read commands
	bStartScan := TRUE;
END_IF


CASE nState OF
    0: // Idle - wait for start trigger
        IF bStartScan THEN
            bStartScan := FALSE;
            bDone      := FALSE;
            bError     := FALSE;
            nErrId     := 0;
            nIndex     := 1;
            nState     := 10;
        END_IF

    10: // STEP 1: Trigger read for Axis Name (Group 16#4000, Offset 16#02)
        IF driveGlobals.ncAxis[nIndex].NcToPlc.AxisId = 0 THEN
            Axis.axisPresent[nIndex].AxisName   := '';
            Axis.axisPresent[nIndex].AxisNumber := 0;
            Axis.axisPresent[nIndex].AxisType   := 0;
            Axis.axisPresent[nIndex].DriveName  := '';
            nState := 70; // Skip to next axis
        ELSE
            sAxisName := '';
            fbReadAds(
                NETID    := '',
                PORT     := 500,
                IDXGRP   := 16#4000 + driveGlobals.ncAxis[nIndex].NcToPlc.AxisId,
                IDXOFFS  := 16#00000002,
                LEN      := SIZEOF(sAxisName),
                DESTADDR := ADR(sAxisName),
                READ     := TRUE
            );
            nState := 20;
        END_IF

    20: // Wait for Axis Name read to finish
        fbReadAds(READ := FALSE);
        IF NOT fbReadAds.BUSY THEN
            IF fbReadAds.ERR THEN
                bError := TRUE;
                nErrId := fbReadAds.ERRID;
                nState := 0;
            ELSE
                Axis.axisPresent[nIndex].AxisName   := sAxisName;
                Axis.axisPresent[nIndex].AxisNumber := driveGlobals.ncAxis[nIndex].NcToPlc.AxisId;
                nState := 30; // Proceed to Axis Type
            END_IF
        END_IF

    30: // STEP 2: Trigger read for Axis Type (Group 16#4000, Offset 16#03)
        nAxisType := 0;
        fbReadAds(
            NETID    := '',
            PORT     := 500,
            IDXGRP   := 16#4000 + driveGlobals.ncAxis[nIndex].NcToPlc.AxisId,
            IDXOFFS  := 16#00000003,
            LEN      := SIZEOF(nAxisType),
            DESTADDR := ADR(nAxisType),
            READ     := TRUE
        );
        nState := 40;

    40: // Wait for Axis Type read to finish
        fbReadAds(READ := FALSE);
        IF NOT fbReadAds.BUSY THEN
            IF fbReadAds.ERR THEN
                bError := TRUE;
                nErrId := fbReadAds.ERRID;
                nState := 0;
            ELSE
                Axis.axisPresent[nIndex].AxisType := nAxisType;
                nState := 50; // Proceed to NC Drive Name
            END_IF
        END_IF

    50: // STEP 3: Trigger read for NC Drive Name (Group 16#7000, Offset 16#02)
        sDriveName := '';
        fbReadAds(
            NETID    := '',
            PORT     := 500,
            IDXGRP   := 16#7000 + driveGlobals.ncAxis[nIndex].NcToPlc.AxisId,
            IDXOFFS  := 16#00000002,
            LEN      := SIZEOF(sDriveName),
            DESTADDR := ADR(sDriveName),
            READ     := TRUE
        );
        nState := 60;

    60: // Wait for NC Drive Name read to finish
        fbReadAds(READ := FALSE);
        IF NOT fbReadAds.BUSY THEN
            IF fbReadAds.ERR THEN
                // Note: Virtual/Encoder-only axes might not have a Drive object (Error 1804/0x70C).
                // Clear name and continue instead of aborting if that happens:
                IF fbReadAds.ERRID = 16#70C THEN
                    Axis.axisPresent[nIndex].DriveName := '';
                    nState := 70;
                ELSE
                    bError := TRUE;
                    nErrId := fbReadAds.ERRID;
                    nState := 0;
                END_IF
            ELSE
                Axis.axisPresent[nIndex].DriveName := sDriveName;
                nState := 70;
            END_IF
        END_IF
		
	70:
		F_SplitStringAtSpace(	sInput :=  Axis.axisPresent[nIndex].AxisName,
			str1   => Axis.axisPresent[nIndex].AxisDef,    // Output: 'Z1'
   			str2   => Axis.axisPresent[nIndex].AxisName     // Output: 'Axis'
			);
		nState := 80;		 
		

    80: // Increment index or finish
        IF nIndex < 16 THEN
            nIndex := nIndex + 1;
            nState := 10;
        ELSE
            bDone  := TRUE;
            nState := 100;
        END_IF
		
		
	100:
	fbReadAxisCount(
    READ     := FALSE
	);
	nState := 110;
	
	110:
	fbReadAxisCount(
    NETID    := '',               // Local target
    PORT     := 500,              // NC-Task 1 SAF default ADS port
    IDXGRP   := 16#00001100,      // Ring-0-Manager State group
    IDXOFFS  := 16#00000003,      // Offset 0x03 = Number of axes
    LEN      := SIZEOF(nAxisCount),
    DESTADDR := ADR(nAxisCount),
    READ     := TRUE
	);
	
	nState := 120;
	
	120:
	fbReadAxisCount(READ     := FALSE	);
	
	IF NOT fbReadAxisCount.BUSY THEN
		 IF fbReadAxisCount.ERR THEN
                bError := TRUE;
                nErrId := fbReadAxisCount.ERRID;
                nState := 0;
            ELSE
               nState := 130; // next
			   Axis.gNumAxisInSystem := nAxisCount;
            END_IF
	END_IF
	
	130:
	nState := 0;
	
		
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="actSelectAxis" Id="{4ed42672-50b6-4ef5-b39f-b5e233271a55}">
      <Implementation>
        <ST><![CDATA[//limits check for memcpy
IF Axis.axisSelectNum < 1 THEN
	Axis.axisSelectNum := 1;
END_IF

//limits check for memcpy
IF Axis.axisSelectNum > Axis.gNumAxisInSystem THEN
	Axis.axisSelectNum := Axis.gNumAxisInSystem;
END_IF

//move the axis data from the database of axis present in the system to the HMI data
retvall := memcpy( destAddr := ADR(Axis.axisSelected),
					srcAddr := ADR(axis.axisPresent[Axis.axisSelectNum]),
					n		:= SIZEOF(Axis.axisSelected)
					);
					]]></ST>
      </Implementation>
    </Action>
