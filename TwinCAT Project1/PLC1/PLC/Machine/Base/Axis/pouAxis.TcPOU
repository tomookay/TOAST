<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="pouAxis" Id="{0a1eb7e7-2ca7-4349-8d96-78253461d98b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM pouAxis
VAR
	retvall: UDINT;
	nAxisId   : UDINT;
 
	bStartScan   : BOOL;            // Set TRUE to begin reading all 16 axes
    bDone        : BOOL;            // TRUE when all 16 axes are read
    bError       : BOOL;            // TRUE if an ADS read fails
    nErrId       : UDINT;           // ADS error code if bError is TRUE
    
    nState       : INT := 0;        // State machine step
    nIndex       : INT := 1;        // Current axis index (1..16)
    fbReadAds    : ADSREAD;         // ADS Read function block
    
    // Read buffers
    sAxisName    : STRING(30);      // Offset 16#00000002 (Grp 16#4000)
    nAxisType    : UDINT;           // Offset 16#00000003 (Grp 16#4000)
    sDriveName   : STRING(30);      // Offset 16#00000002 (Grp 16#7000)
	
	osrRead:R_TRIG;
	
	fbReadAxisCount : ADSREAD;
    nAxisCount      : UDINT;      // Receives total number of NC axes (0..255)
    bGetAxisCount   : BOOL;       // Trigger to read count
	
END_VAR
]]></Declaration>
