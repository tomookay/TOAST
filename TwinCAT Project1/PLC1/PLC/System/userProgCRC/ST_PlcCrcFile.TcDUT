<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <DUT Name="ST_PlcCrcFile" Id="{267c2ed6-2b34-0a2d-3755-b1e5c4905a48}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '1'}
TYPE ST_PlcCrcFile :
STRUCT
    dwCodeCrc       : DWORD; // Bytes 0..3:  Compiled code CRC (Repeatable on clean rebuild)
    dwDataCrc       : DWORD; // Bytes 4..7:  Data/memory layout CRC (Repeatable on clean rebuild)
    dwBuildInfo1    : DWORD; // Bytes 8..11: Build/compile hash (Changes per build)
    dwBuildInfo2    : DWORD; // Bytes 12..15: Online change / metadata hash
    dwBuildInfo3    : DWORD; // Bytes 16..19: Additional internal hash
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>