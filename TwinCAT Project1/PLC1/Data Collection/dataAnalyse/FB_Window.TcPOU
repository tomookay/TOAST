<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="FB_Window" Id="{4cf7a1dd-4be4-0676-17d1-6d8992ea43f1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Window
VAR
    i : DINT; //loop counter
    SampleSpansBoxTime  : BOOL; //check if the data sample was an edge case between lines
    EnteredViaValidSide : BOOL; //TRUE if the line was a valid entry
    HasExitedBox        : BOOL; //TRUE if the line exited the box
    PermissionViolation : BOOL; // Flagged if it passes through an unpermitted line
    ValidEntrySide      : INT;  // 1 = Side A, 3 = Side C, 4 = Side D
    TrappedSuccessfully : BOOL; 
	
	osrStartAnalysis:R_TRIG;
	
END_VAR
VAR_INPUT
	//data to check
	dataAxis: typeDataAxis;

    // Corner Points
    i1 : ST_BoxCorner; // Top-Left
    i2 : ST_BoxCorner; // Bottom-Left
    i3 : ST_BoxCorner; // Bottom-Right
    i4 : ST_BoxCorner; // Top-Right

    // Wall Permissions 
    LeftPermSide : ST_WallPermission; // Left Wall Permissions
    RightPermSide : ST_WallPermission; // Right Wall Permissions
    TopPermSide : ST_WallPermission; // Top Wall Permissions
    BottomPermSide : ST_WallPermission; // Bottom Wall Permissions
	
	iPerformAnalysis:BOOL;
		
END_VAR

VAR_OUTPUT
    qPass : BOOL; // TRUE if data entered legally and followed all rules
    qFail : BOOL; // TRUE if any permission rule was violated or it leaked out
	qErrorCode : E_BoxResultCode; //diag codes
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Reset tracking variables before running the historical loop
EnteredViaValidSide := FALSE;
HasExitedBox        := FALSE;
PermissionViolation := FALSE;
ValidEntrySide      := 0; 
qPass               := FALSE;
qFail               := FALSE;
qErrorCode          := E_BoxResultCode.Success; // Default to Success state

osrStartAnalysis(clk := iPerformAnalysis);

IF osrStartAnalysis.Q THEN


// CRITICAL FIX: Cap dynamic loops safely to actual array limit 
FOR i := 2 TO 20000 DO
    
    SampleSpansBoxTime := (dataAxis.grabTime[i] >= i2.PointXTime) AND (dataAxis.grabTime[i-1] <= i3.PointXTime);

    // =========================================================================
    // PART 1: ENTRY DETECTION & ENUM ENTRY CONFIG CHECKS
    // =========================================================================
    IF NOT EnteredViaValidSide AND NOT PermissionViolation THEN
        
        // 1. SIDE A ENTRY (Left Wall)
        IF (dataAxis.grabTime[i-1] < i2.PointXTime) AND (dataAxis.grabTime[i] >= i2.PointXTime) THEN
            IF (dataAxis.grabData[i] > i2.PointYValue) AND (dataAxis.grabData[i] < i1.PointYValue) THEN
                
                IF LeftPermSide.EntryRule = E_WallEntryRule.MustNotEnter THEN
                    PermissionViolation := TRUE;
                    qErrorCode          := E_BoxResultCode.Err_IllegalEntry_SideA;
                ELSE
                    EnteredViaValidSide := TRUE;
                    ValidEntrySide      := 1; // Mapped to Side A
                END_IF
            END_IF
        END_IF

        // 2. SIDE D ENTRY (Bottom Wall)
        IF (dataAxis.grabTime[i] >= i2.PointXTime) AND (dataAxis.grabTime[i] <= i3.PointXTime) THEN
            IF (dataAxis.grabData[i-1] < i2.PointYValue) AND (dataAxis.grabData[i] >= i2.PointYValue) THEN
                
                IF BottomPermSide.EntryRule = E_WallEntryRule.MustNotEnter THEN
                    PermissionViolation := TRUE;
                    qErrorCode          := E_BoxResultCode.Err_IllegalEntry_SideD;
                ELSE
                    EnteredViaValidSide := TRUE;
                    ValidEntrySide      := 4; // Mapped to Side D
                END_IF
            END_IF
        END_IF
		
        // 3. SIDE C ENTRY (Top Wall)
        IF (dataAxis.grabTime[i] >= i2.PointXTime) AND (dataAxis.grabTime[i] <= i3.PointXTime) THEN
            IF (dataAxis.grabData[i-1] > i1.PointYValue) AND (dataAxis.grabData[i] <= i1.PointYValue) THEN
                
                IF TopPermSide.EntryRule = E_WallEntryRule.MustNotEnter THEN
                    PermissionViolation := TRUE;
                    qErrorCode          := E_BoxResultCode.Err_IllegalEntry_SideC;
                ELSE
                    EnteredViaValidSide := TRUE;
                    ValidEntrySide      := 3; // Mapped to Side C
                END_IF
            END_IF
        END_IF
        
        // Break out instantly if the curve broke in through an illegal wall
        IF PermissionViolation THEN
            EXIT;
        END_IF
    END_IF

    // =========================================================================
    // PART 2: EXIT VIOLATION DETECTION (Evaluates immediately if Entered)
    // =========================================================================
    IF EnteredViaValidSide THEN 
        
        // 1. EXIT VIA SIDE B (Right Wall)
        IF (dataAxis.grabTime[i-1] <= i3.PointXTime) AND (dataAxis.grabTime[i] > i3.PointXTime) THEN
            IF (dataAxis.grabData[i] > i3.PointYValue) AND (dataAxis.grabData[i] < i4.PointYValue) THEN
                HasExitedBox := TRUE;
                IF RightPermSide.IsNotPermittedToExit THEN
                    PermissionViolation := TRUE;
                    qErrorCode          := E_BoxResultCode.Violation_Exited_SideB;
                ELSE
                    qErrorCode          := E_BoxResultCode.Success; // Valid completion code
                END_IF
            END_IF
        END_IF

        // 2. EXIT VIA SIDE A (Left Wall)
        IF (dataAxis.grabTime[i-1] >= i2.PointXTime) AND (dataAxis.grabTime[i] < i2.PointXTime) THEN
            IF (dataAxis.grabData[i] > i2.PointYValue) AND (dataAxis.grabData[i] < i1.PointYValue) THEN
                HasExitedBox := TRUE;
                IF LeftPermSide.IsNotPermittedToExit THEN
                    PermissionViolation := TRUE;
                    qErrorCode          := E_BoxResultCode.Violation_Exited_SideA;
                ELSE
                    qErrorCode          := E_BoxResultCode.Leak_Exited_SideA;
                END_IF
            END_IF
        END_IF

        // 3. EXIT VIA SIDE C (Top Wall)
        IF SampleSpansBoxTime THEN
            IF (dataAxis.grabData[i-1] <= i1.PointYValue) AND (dataAxis.grabData[i] > i1.PointYValue) THEN
                HasExitedBox := TRUE;
                IF TopPermSide.IsNotPermittedToExit THEN
                    PermissionViolation := TRUE;
                    qErrorCode          := E_BoxResultCode.Violation_Exited_SideC;
                ELSE
                    qErrorCode          := E_BoxResultCode.Leak_Exited_SideC;
                END_IF
            END_IF
        END_IF

        // 4. EXIT VIA SIDE D (Bottom Wall)
        IF SampleSpansBoxTime THEN
            IF (dataAxis.grabData[i-1] >= i2.PointYValue) AND (dataAxis.grabData[i] < i2.PointYValue) THEN
                HasExitedBox := TRUE;
                IF BottomPermSide.IsNotPermittedToExit THEN
                    PermissionViolation := TRUE;
                    qErrorCode          := E_BoxResultCode.Violation_Exited_SideD;
                ELSE
                    qErrorCode          := E_BoxResultCode.Leak_Exited_SideD;
                END_IF
            END_IF
        END_IF
        
        // Break loop early if an exit occurred or a specific permission rule was violated
        IF HasExitedBox OR PermissionViolation THEN
            EXIT; 
        END_IF

    END_IF

END_FOR

// =========================================================================
// PART 3: FINAL EVALUATION & MUTUALLY EXCLUSIVE OUTPUTS
// =========================================================================

// Catch the edge case where the loop finished but the signal never even hit a box boundary
	IF NOT EnteredViaValidSide AND NOT PermissionViolation THEN
		qErrorCode := E_BoxResultCode.Err_NeverEnteredBox;
	END_IF
	
	// CRITICAL FIX: Crosscheck "Must Enter" rules across all sides.
	// If any side was marked "Must Enter", but our actual entry side doesn't match it, fail the test.
	IF EnteredViaValidSide AND NOT PermissionViolation THEN
		IF (LeftPermSide.EntryRule = E_WallEntryRule.MustEnter AND ValidEntrySide <> 1) OR
		   (TopPermSide.EntryRule = E_WallEntryRule.MustEnter AND ValidEntrySide <> 3) OR
		   (BottomPermSide.EntryRule = E_WallEntryRule.MustEnter AND ValidEntrySide <> 4) THEN
			
			PermissionViolation := TRUE;
			qErrorCode          := E_BoxResultCode.Err_WrongEntryWall; 
		END_IF
	END_IF

// Evaluate final pass/fail flags
	IF EnteredViaValidSide AND NOT PermissionViolation AND (qErrorCode = E_BoxResultCode.Success) THEN
		qPass      := TRUE;
		qFail      := FALSE;
	ELSE
		qPass      := FALSE;
		qFail      := TRUE;
	END_IF

END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_Window">
      <LineId Id="2003" Count="7" />
      <LineId Id="2173" Count="0" />
      <LineId Id="2166" Count="0" />
      <LineId Id="2174" Count="0" />
      <LineId Id="2167" Count="0" />
      <LineId Id="2172" Count="0" />
      <LineId Id="2011" Count="152" />
      <LineId Id="62" Count="0" />
      <LineId Id="2176" Count="0" />
      <LineId Id="2175" Count="0" />
    </LineIds>
  </POU>
