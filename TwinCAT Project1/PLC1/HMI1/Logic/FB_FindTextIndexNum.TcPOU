<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="FB_FindTextIndexNum" Id="{ef499ef2-7994-44de-86ff-07d709cf8dbb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FindTextIndexNum
VAR_INPUT
    iText : T_MaxString; // Input text string to parse
END_VAR
VAR_OUTPUT
    qIndexNum    : INT;  // Retains the last successfully extracted index number
    qLineIsValid : BOOL; // Retains TRUE for exactly one cycle when a line is found
END_VAR
VAR
    posTextID : INT; // Position of "TextID"
    posStart  : INT; // Position of '">"'
    posEnd    : INT; // Position of '"</v>'
    strIndex  : STRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. ALWAYS reset the valid strobe at the start of the cycle.
// This prevents a single valid line from indicating "TRUE" forever.
qLineIsValid := FALSE; 

// 2. Only run parsing if the input string actually contains "TextID"
posTextID := FIND(iText, 'TextID');

IF posTextID > 0 THEN
    posStart := FIND(iText, '">"');
    posEnd   := FIND(iText, '"</v>');
    
    // 3. Robust tag boundaries validation
    IF (posStart > 0) AND (posEnd > posStart) THEN
        
        // Safe middle-string extraction
        strIndex := MID(STR  := iText, 
                        LEN  := posEnd - (posStart + 3), 
                        POS  := posStart + 3);
        
        // 4. Convert string to numerical integer
        // NOTE: qIndexNum is ONLY overwritten right here if the line is valid.
        qIndexNum    := STRING_TO_INT(strIndex); 
        qLineIsValid := TRUE; // Signal to your main program that a new value arrived
        
    END_IF
END_IF

// If posTextID is 0 (empty line or different XML tag), 
// qIndexNum skips the logic entirely and holds its previous value in PLC memory.]]></ST>
    </Implementation>
    <LineIds Name="FB_FindTextIndexNum">
      <LineId Id="178" Count="27" />
      <LineId Id="75" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>